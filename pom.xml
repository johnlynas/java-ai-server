<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<!-- Root parent: inherits Spring Boot 4.2.0 (spring-boot-dependencies BOM comes with it) -->
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.2.0</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>

	<groupId>com.nipp</groupId>
	<artifactId>java-ai-server</artifactId>
	<version>1.0.0-SNAPSHOT</version>
	<packaging>pom</packaging>

	<name>java-ai-server</name>
	<description>Spring AI monorepo: shared contracts + app-server, ai-agent, mcp-server</description>

	<modules>
		<module>shared-contracts</module>
		<module>app-server</module>
		<module>ai-agent</module>
		<module>mcp-server</module>
	</modules>

	<properties>
		<java.version>21</java.version>
		<spring-ai.version>2.1.0</spring-ai.version>
	</properties>

	<dependencyManagement>
		<dependencies>
			<!-- Import Spring AI BOM once here so no sub-module ever pins its own version -->
			<dependency>
				<groupId>org.springframework.ai</groupId>
				<artifactId>spring-ai-bom</artifactId>
				<version>${spring-ai.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>

			<!-- Internal module: managed here so consumers omit the version -->
			<dependency>
				<groupId>com.nipp</groupId>
				<artifactId>shared-contracts</artifactId>
				<version>${project.version}</version>
			</dependency>
		</dependencies>
	</dependencyManagement>

</project>
